# 任务 → 模型档位路由表模板。仓库里已有可直接使用的 config/routing.yaml；
#
# 这个文件可以安全入 git：所有凭据与地址都写成 `${NAME}`，由 app/llm/routing.py
# 从 Settings（即 .env）展开，变量白名单见该文件的 routing_env()。
#
# 改这个文件不需要改代码——帕累托实验（§4 的 C1–C8）就是靠改 routes 切配置的。
version: 1
model_catalog: model-catalog.json

defaults:
  timeout_s: 30

tiers:
  # 分类、改写、记忆操作这类高频低难度任务；未部署时留空，路由会沿 fallback 降到 main。
  light:
    primary:
      provider: openai_compatible
      base_url: ${TIER_LIGHT_BASE_URL}
      api_key: ${CLUSTER_API_KEY}
      model: ${TIER_LIGHT_MODEL}
      enable_thinking: ${TIER_LIGHT_ENABLE_THINKING}
      context_window_tokens: auto
    # fallback 不传递：每档写全自己的链路，别指望接上 main 的那一串。
    fallback: [main, heavy, external]

  # 甜点档：MoE 每 token 只激活约 3B，延迟接近小模型、质量接近稠密大模型。
  main:
    primary:
      provider: openai_compatible
      base_url: ${TIER_MAIN_BASE_URL}
      api_key: ${CLUSTER_API_KEY}
      model: ${TIER_MAIN_MODEL}
      enable_thinking: ${TIER_MAIN_ENABLE_THINKING}
      context_window_tokens: auto
    fallback: [heavy, external]

  # 规划、反思、判分：这些环节错了会级联放大，省钱最不划算。
  heavy:
    primary:
      provider: openai_compatible
      base_url: ${TIER_HEAVY_BASE_URL}
      api_key: ${CLUSTER_API_KEY}
      model: ${TIER_HEAVY_MODEL}
      enable_thinking: ${TIER_HEAVY_ENABLE_THINKING}
      context_window_tokens: auto
    fallback: [main, external]

  # 商用 API：对照基线 + 集群整体不可用时的兜底。它自己不再 fallback。
  external:
    primary:
      provider: openai_compatible
      base_url: ${TIER_EXTERNAL_BASE_URL}
      api_key: ${EXTERNAL_API_KEY}
      model: ${TIER_EXTERNAL_MODEL}
      context_window_tokens: ${TIER_EXTERNAL_CONTEXT_WINDOW_TOKENS}
    fallback: []

# 左边是代码里真实传给 gateway 的 task_type，不是 docs/07 §2 表格里的类别名。
# 对不上就会静默落到 default_route，路由表也就白写了。
routes:
  # —— 生成：甜点档。质量与成本的最优点，也是 §4 帕累托实验的基准配置。
  grounded_answer: main
  general_answer: main
  agent_generate_review: main
  agent_compare_documents: main
  cowork_decision:
    tier: main
    timeout_s: ${COWORK_MODEL_TIMEOUT_S}
  cowork_semantic_approval:
    tier: main
    timeout_s: ${COWORK_MODEL_TIMEOUT_S}

  # —— 改写/分解：高频、对单次质量不敏感，后面还有检索与 rerank 兜底。
  query_decomposition: light
  contextual_query_rewrite: light
  edit_rewrite: light
  conversation_summary: main
  cowork_compaction:
    tier: main
    timeout_s: ${COWORK_MODEL_TIMEOUT_S}
  memory_op: light

  # —— 结构化抽取：**刻意留在 main**。
  # docs/07 §3 的结构化抽取升档仍未接入这些 producer；不要先把起始档降到 light。
  # 在没有升档兜底的情况下先降到 light，等于把 A1/A2 已经量到的首轮合格率
  # （抽卡 30%）再往下压一截。等 §3 落地后这两行才改成 light。
  evidence_sufficiency: main
  agent_extract_card: main
  eval_agent_evidence_anchor: main
  eval_memory_injection: main

  # —— 判分：错了会污染整个评测体系，最不该省钱的一档。
  judge: heavy

# 置信度驱动的动态升档（§3）：起始档跑完、确定性检查不达标时换这一档重做。
# 与 fallback 不同——fallback 处理"调用失败"，升档处理"调用成功但结果不可信"。
#
# 目标 == 起始档表示登记但未启用；目标严格更高才生效。结构化抽取两项目前仍未启用。
# Cowork 则只在“第一次引用 repair 后仍未通过本地引用账本校验”时从 main 升到 heavy；
# 普通回答不升档，provider 失败仍使用 fallback。
escalation:
  evidence_sufficiency: main
  agent_extract_card: main
  cowork_decision: heavy

# 未登记的 task_type 落到甜点档，并靠 llm_calls 的审计发现遗漏。
default_route: main

modes:
  online:
    fallback_enabled: true
  # 评测禁用 fallback（§7.4）：否则台账写着 heavy、实际由别的模型作答，且没人知道。
  evaluation:
    fallback_enabled: false
