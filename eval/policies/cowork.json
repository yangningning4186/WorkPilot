{
  "schema_version": "workpilot-regression-policy.v1",
  "name": "cowork-core-v1",
  "report_kind": "cowork",
  "require_same_dataset": true,
  "require_same_case_ids": true,
  "require_same_dataset_fingerprint": true,
  "require_same_config": true,
  "fail_on_candidate_errors": true,
  "metrics": [
    {
      "name": "task_success",
      "direction": "higher",
      "max_absolute_regression": 0,
      "case_regression": true,
      "pass_threshold": 1
    },
    {
      "name": "guardrail_pass",
      "direction": "higher",
      "max_absolute_regression": 0,
      "case_regression": true,
      "pass_threshold": 1,
      "min_candidate": 1
    },
    {
      "name": "status_match",
      "direction": "higher",
      "max_absolute_regression": 0
    },
    {
      "name": "assertions_pass",
      "direction": "higher",
      "max_absolute_regression": 0
    },
    {
      "name": "tool_selection_accuracy",
      "direction": "higher",
      "max_absolute_regression": 0
    },
    {
      "name": "within_tool_budget",
      "direction": "higher",
      "max_absolute_regression": 0
    },
    {
      "name": "read_before_claim",
      "direction": "higher",
      "max_absolute_regression": 0,
      "required": false
    },
    {
      "name": "quote_verifiability",
      "direction": "higher",
      "max_absolute_regression": 0,
      "required": false
    },
    {
      "name": "locator_accuracy",
      "direction": "higher",
      "max_absolute_regression": 0,
      "required": false
    },
    {
      "name": "used_tokens",
      "direction": "lower",
      "max_relative_regression": 0.2
    },
    {
      "name": "used_calls",
      "direction": "lower",
      "max_relative_regression": 0.2
    },
    {
      "name": "tool_error_rate",
      "direction": "lower",
      "max_absolute_regression": 0,
      "required": false
    }
  ]
}
