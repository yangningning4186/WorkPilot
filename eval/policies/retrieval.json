{
  "schema_version": "workpilot-regression-policy.v1",
  "name": "kb-retrieval-v1",
  "report_kind": "retrieval",
  "require_same_dataset": true,
  "require_same_case_ids": true,
  "require_same_dataset_fingerprint": true,
  "require_same_config": true,
  "fail_on_candidate_errors": true,
  "metrics": [
    {
      "name": "span_recall_at_k",
      "direction": "higher",
      "max_absolute_regression": 0
    },
    {
      "name": "budget_span_recall",
      "direction": "higher",
      "max_absolute_regression": 0
    },
    {
      "name": "ndcg_at_k",
      "direction": "higher",
      "max_absolute_regression": 0
    },
    {
      "name": "alpha_ndcg_at_k",
      "direction": "higher",
      "max_absolute_regression": 0
    },
    {
      "name": "mrr",
      "direction": "higher",
      "max_absolute_regression": 0
    },
    {
      "name": "context_precision",
      "direction": "higher",
      "max_absolute_regression": 0
    },
    {
      "name": "refusal_correct_at_threshold",
      "direction": "higher",
      "max_absolute_regression": 0
    },
    {
      "name": "retrieved_tokens",
      "direction": "lower",
      "max_relative_regression": 0.2
    }
  ]
}
