# 复制为 .env 后填入真实值。.env 已在 .gitignore 中。

# development/test 才允许打开本地标注页面；production 会强制返回 404。
APP_ENV=development
ANNOTATION_TOOL_ENABLED=true

# ---------- 基础设施 ----------
DATABASE_URL=postgresql+asyncpg://workpilot:workpilot@localhost:5432/workpilot
TEST_DATABASE_URL=postgresql+asyncpg://workpilot:workpilot@localhost:5432/workpilot_test
REDIS_URL=redis://localhost:6379/0
# 匿名 demo session；Secure 未配置时 production=true，其余环境=false。
SESSION_COOKIE_NAME=workpilot_session
SESSION_TTL_S=1800
# 生产环境会自动启用 Secure；仅在反向代理终止 HTTPS 等特殊部署中显式覆盖。
# SESSION_COOKIE_SECURE=true
ADMIN_COOKIE_NAME=workpilot_admin_session
ADMIN_SESSION_TTL_S=28800
# 用 `cd backend && uv run python -m app.cli.hash_admin_password` 生成，禁止填写明文。
DEMO_ADMIN_PASSWORD_HASH=
# 请求层 token bucket；未配置时仅 production 自动开启。
# IP_RATE_LIMIT_ENABLED=true
IP_RATE_LIMIT_PER_MINUTE=20
IP_RATE_LIMIT_BURST=5
DEMO_SESSION_QUESTION_LIMIT=20
# M1+ 可选；M0 不启动 MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=workpilot

# ---------- Cowork / 桌面 sidecar ----------
# Cowork 目录授权、capability grant 与 artifacts API 总开关。
COWORK_ENABLED=true
COWORK_MAX_STEPS=12
COWORK_DECISION_MAX_TOKENS=2048
COWORK_TOOL_RESULT_MAX_CHARS=20000
COWORK_COMPACTION_ENABLED=true
COWORK_COMPACTION_TRIGGER_RATIO=0.85
COWORK_COMPACTION_KEEP_RECENT_TOOL_ROUNDS=2
COWORK_COMPACTION_MAX_SUMMARY_CHARS=4000
COWORK_COMPACTION_INPUT_MAX_CHARS=60000
COWORK_COMPACTION_MAX_TOKENS=800
COWORK_CONTEXT_OVERFLOW_MAX_RECOVERIES=2
# JSON 数组；例如 git status 允许 git status --short，但不允许 git statusx。
# 任何含 ; | & > < $() 反引号或换行的命令都不会命中 allowlist，必须逐命令审批。
COWORK_SHELL_ALLOWLIST=[]
COWORK_SHELL_TIMEOUT_S=120
COWORK_SHELL_TERMINATE_GRACE_S=2
COWORK_SHELL_MAX_OUTPUT_BYTES=65536
COWORK_CANCEL_POLL_S=0.5
# Tauri 桌面壳启动 Python sidecar 时设为 true，并为每次启动注入新的随机 token。
# token 不写入配置文件或日志；这里只保留关闭状态的示例。
DESKTOP_MODE_ENABLED=false
DESKTOP_LAUNCH_TOKEN=

# ---------- 自建推理集群（OpenAI 兼容协议） ----------
# 档位定义与任务路由见 config/routing.yaml。
# 未部署的档位把 BASE_URL 与 MODEL 留空即可：线上会沿该档声明的 fallback 链降级
# 并在启动日志里告警，评测模式则直接失败（绝不静默替换）。
TIER_LIGHT_BASE_URL=http://<cluster-host>:8101/v1
TIER_LIGHT_MODEL=qwen3.5-4b
TIER_LIGHT_CONTEXT_WINDOW_TOKENS=32768
TIER_LIGHT_ENABLE_THINKING=

TIER_MAIN_BASE_URL=http://<cluster-host>:8102/v1
TIER_MAIN_MODEL=qwen3.6-35b-a3b
TIER_MAIN_CONTEXT_WINDOW_TOKENS=102400
# Qwen/vLLM 可设 false 关闭思考输出, 结构化门控更稳定; 不支持该字段的 provider 留空。
TIER_MAIN_ENABLE_THINKING=

TIER_HEAVY_BASE_URL=http://<cluster-host>:8103/v1
TIER_HEAVY_MODEL=deepseek-v4-flash
TIER_HEAVY_CONTEXT_WINDOW_TOKENS=1048576
TIER_HEAVY_ENABLE_THINKING=

# 集群通常无需鉴权，占位即可
CLUSTER_API_KEY=EMPTY

# 路由表位置。相对路径以 backend/ 为基准。
ROUTING_CONFIG_PATH=../config/routing.yaml

# ---------- 商用 API（对照基线 + 集群不可用兜底 + 线上 demo） ----------
# external 档同样走 OpenAI 兼容协议；用非兼容协议的服务需要新增 provider 实现。
TIER_EXTERNAL_BASE_URL=
TIER_EXTERNAL_MODEL=
TIER_EXTERNAL_CONTEXT_WINDOW_TOKENS=128000
LLM_CONTEXT_SAFETY_TOKENS=512
EXTERNAL_API_KEY=

# ---------- 自建 GPU 成本口径（docs/07 §7.2-7.3） ----------
# 自建模型没有账单，成本按整批 GPU wall time 摊销：
#   批次成本 = (等价云单价 / 3600) × 批次墙钟秒 × 节点数
#   单任务   = 批次成本 / 批次内任务数
# 默认留空，开跑批时会**硬失败**——编一个单价会让下游每个成本数字都失去意义，
# 而且从结果里看不出来是编的。GPU_PRICE_SOURCE 必须写得能被追溯（报价页面 + 查询日期）。
GPU_MODEL=
GPU_PRICE_USD_PER_HOUR=0
GPU_PRICE_SOURCE=
GPU_NODE_COUNT=1

# ---------- 档位单价（每百万 token，USD） ----------
# 只用于预算闸门。自建档位填 0：它们的成本不是 API 账单，而是按整批 GPU wall time
# 摊销（docs/07 §7.2）。只有真正按量计费的 external 档需要填真实单价。
PRICE_LIGHT_INPUT_USD_PER_MTOK=0
PRICE_LIGHT_OUTPUT_USD_PER_MTOK=0
PRICE_MAIN_INPUT_USD_PER_MTOK=0
PRICE_MAIN_OUTPUT_USD_PER_MTOK=0
PRICE_HEAVY_INPUT_USD_PER_MTOK=0
PRICE_HEAVY_OUTPUT_USD_PER_MTOK=0
PRICE_EXTERNAL_INPUT_USD_PER_MTOK=0
PRICE_EXTERNAL_OUTPUT_USD_PER_MTOK=0

# ---------- Embedding / Rerank ----------
EMBEDDING_MODEL=bge-m3:latest
# 模型文件/服务变化时必须修改；用于阻止不同向量空间混检。
EMBEDDING_REVISION=sha256-daec91ffb5dd0c27411bd71f29932917c49cf529a641d0168496c3a501e3062c
# 必须与 pgvector chunks.embedding 的固定维度一致
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=main
RERANKER_BASE_URL=http://127.0.0.1:8011
RERANKER_DEVICE=auto
RERANKER_DTYPE=auto
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=512
RERANKER_TIMEOUT_S=10
# 本地加载 或 走推理服务
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# 本地和内网模型默认绕过 HTTP_PROXY/HTTPS_PROXY。
MODEL_TRUST_ENV=false

# ---------- PDF 解析护栏 ----------
# auto: 简单文本 PDF 用 PyMuPDF，复杂/扫描 PDF 优先 MinerU。
PDF_PARSER_MODE=auto
PDF_PARSE_TIMEOUT_S=120
PDF_MAX_PAGES=500
PDF_MAX_BYTES=52428800
PDF_WORKER_MEMORY_MB=2048
PDF_WORKER_CPU_S=120
# MinerU 使用独立环境，不加入 FastAPI 运行时依赖。
PDF_MINERU_COMMAND=../.mineru/.venv/bin/mineru
PDF_MINERU_REVISION=3.4.4
PDF_MINERU_BACKEND=hybrid-engine
PDF_MINERU_EFFORT=medium
PDF_MINERU_METHOD=auto
PDF_MINERU_TIMEOUT_S=1800
PDF_MINERU_FALLBACK_ENABLED=true
PDF_MINERU_PROCESSING_WINDOW_SIZE=4

# ---------- 可观测（M1+ 可选） ----------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- 检索参数（实验会覆盖，此处为默认值） ----------
CHUNK_STRATEGY=heading
# pgvector 扫描参数（docs/03 §4.1）。部分索引只覆盖 strategy + is_searchable，
# embedding 身份等条件仍在索引内过滤，靠迭代扫描兜底候选不足。
HNSW_ITERATIVE_SCAN=relaxed_order
HNSW_MAX_SCAN_TUPLES=20000
# ef_search 必须不小于 top_k，否则召回会被候选队列长度截断。
HNSW_EF_SEARCH=100
RETRIEVE_TOP_K=50
RERANK_TOP_K=5
RRF_K=60
REFUSAL_THRESHOLD=0.35
# 数值分数门必须绑定已校准的最终排序器；未校准前由证据充分性门负责拒答。
# 可选 disabled / dense / lexical / fusion / rerank
REFUSAL_SCORE_GATE_SOURCE=disabled
REFUSAL_MARGIN_THRESHOLD=0.03
EVIDENCE_GATE_MAX_CHARS=3000
RERANK_EVIDENCE_GATE_MAX_CHARS=6000
EVIDENCE_GATE_MAX_TOKENS=300
QUERY_DECOMPOSITION_ENABLED=false
QUERY_DECOMPOSITION_MAX_SUBQUERIES=4
QUERY_DECOMPOSITION_MAX_TOKENS=300
# 仅登录 owner 生效；匿名 demo 即使开关为 true 也不会抽取或召回个人记忆。
MEMORY_EXTRACTION_ENABLED=true
MEMORY_RECALL_ENABLED=true
MEMORY_JOB_LEASE_S=120
MEMORY_JOB_MAX_ATTEMPTS=3
MEMORY_RECALL_TOP_K=5
MEMORY_PINNED_LIMIT=3
MEMORY_CONTEXT_MAX_CHARS=2000
# 真实子问题 coverage-aware Top-K；需同时开启 QUERY_DECOMPOSITION_ENABLED。
COVERAGE_SELECTION_ENABLED=false
COVERAGE_RANK_CUTOFF=10
RERANK_ENABLED=false
# dense/lexical 每臂与 RRF 的统一候选池深度；兼容旧变量名。
RERANK_CANDIDATE_K=50
RERANK_MAX_CANDIDATE_CHARS=1200
# 送给 cross-encoder 的候选文本: title_heading_content / heading_content / content
# D6 三档对照判定 title_heading_content 最优, 去掉前缀是负优化
RERANK_CANDIDATE_TEXT_MODE=title_heading_content
LEXICAL_RRF_ENABLED=true
LEXICAL_MODE=ts_rank
ANSWER_MAX_EVIDENCE_CHARS=12000
ANSWER_MAX_TOKENS=1200

# ---------- 预算与熔断 ----------
AGENT_BUDGET_TOKENS=200000
AGENT_BUDGET_CALLS=40
AGENT_BUDGET_WALL_MS=300000
AGENT_MAX_REPLANS=2
AGENT_MAX_RETRIES_PER_STEP=2
DAILY_COST_LIMIT_USD=5.00
COST_BUDGET_TIMEZONE=Asia/Shanghai
# 预留到期后按上限落账的等待时间；必须长于最慢的一次模型调用。
COST_RESERVATION_TTL_S=900
# 预留阶段的 token 估算口径。1 = 1 字符按 1 token 估，是保守上界；
# 估小了并发调用会一起穿透每日上限，估大了只是多占一会儿额度。
COST_ESTIMATE_CHARS_PER_TOKEN=1.0
# 每百万 token 单价。**默认 0 表示本地自部署模型，此时网关跳过预留直接调用。**
# 换成商用 API 时必须填，否则每日成本硬上限形同虚设。
PRICE_MAIN_INPUT_USD_PER_MTOK=0
PRICE_MAIN_OUTPUT_USD_PER_MTOK=0
PRICE_EMBEDDING_INPUT_USD_PER_MTOK=0

# ---------- run 执行与流式 ----------
RUN_BUDGET_TOKENS=200000
RUN_BUDGET_CALLS=40
RUN_BUDGET_WALL_MS=300000
# worker 租约时长；崩溃后最多这么久 watchdog 才会把 run 标记为失败。
RUN_LEASE_S=60
# 心跳必须明显短于租约，否则正常执行的 run 会被误判失联。
RUN_HEARTBEAT_S=15
# delta 批量落库策略（docs/08 §3.3）：满 N 字或满 N 毫秒写一次。
RUN_DELTA_FLUSH_MS=50
RUN_DELTA_FLUSH_CHARS=120

# ---------- 缓存 ----------
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.95
CACHE_TTL_SECONDS=86400

# ---------- 本地资料源 ----------
# 后端命令从 backend/ 启动；生产环境建议填写绝对路径。
LOCAL_LIBRARY_PATH=../data/library
# Agent 只允许向这个独立根目录写相对 .md 路径，不直接改写入库语料。
AGENT_OUTPUT_PATH=../data/agent-output
# 办公工作台的文档、单次 AI 选区、返回替换文本与模型输出上限。
EDITOR_MAX_DOCUMENT_CHARS=500000
EDITOR_MAX_SELECTION_CHARS=12000
EDITOR_MAX_REPLACEMENT_CHARS=50000
EDITOR_REWRITE_MAX_TOKENS=4096
# 写权限绑定当前 owner session，到期后工作台要求重新授权。
EDITOR_PERMISSION_TTL_S=3600
# 工作台扫描/解析护栏；Word/Excel 指令走结构化操作而不是整文件重写。
WORKSPACE_MAX_FILE_BYTES=20971520
WORKSPACE_MAX_FILES=2000
WORKSPACE_MAX_SCAN_ENTRIES=50000
WORKSPACE_MAX_EXCEL_CELLS=5000
WORKSPACE_MAX_EXCEL_SCAN_CELLS=200000
WORKSPACE_MAX_OPERATIONS=100
WORKSPACE_BACKUP_VERSIONS_PER_FILE=10
WORKSPACE_EDIT_MAX_TOKENS=8192
OBSIDIAN_VAULT_PATH=
# Next.js 服务端同源代理的后端地址。不要加结尾斜杠。
BACKEND_ORIGIN=http://127.0.0.1:8000
